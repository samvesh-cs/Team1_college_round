{
  "manifest_version": 3,
  "name": "Handsfree",
  "version": "0.1.0",
  "description": "Navigate webpages using head movement and voice.",
  "action": {
    "default_title": "Handsfree",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/src-content-content.js-CBd-Xtmd.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content/styles/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ]
}
