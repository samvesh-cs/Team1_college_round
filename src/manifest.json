{
  "manifest_version": 3,
  "name": "Handsfree",
  "version": "0.1.0",
  "description": "Navigate webpages using head movement and voice.",
  "action": {
    "default_title": "Handsfree",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": [
        "src/content/styles/overlay.css",
        "src/content/styles/voice-overlay.css",
        "src/content/styles/activation-overlay.css",
        "src/content/styles/calibration-overlay.css",
        "src/content/styles/ai-agent.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "offscreen", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["mediapipe-wasm/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
